    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "monaco-editor": "^0.56.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
