# =============================================================================
# Data Engineer Quest — 環境変数サンプル
# 実際の値は .env.local にコピーして設定する（.env.local はコミットしない）
# =============================================================================

# --- Full Mode切り替え ------------------------------------------------------
# DATABASE_URL が未設定の場合、アプリは自動的に Demo Mode
# （ブラウザのlocalStorageに進捗を保存し、認証・DBを使わない）で動作する。
# Supabaseプロジェクトを用意したら以下を設定して Full Mode に切り替える。

# --- Database (Supabase Postgres / Prisma) ----------------------------------
# Transaction Pooler経由（アプリ実行時用。PgBouncer経由、必ずこちらを使う）
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT_REF].pooler.supabase.com:6543/postgres?pgbouncer=true"
# 直接接続（マイグレーション用。migrate deploy/dev はこちらを使う）
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# --- Supabase Auth ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
SUPABASE_SERVICE_ROLE_KEY="..." # サーバー専用。NEXT_PUBLIC_を付けない・クライアントに漏らさない

# --- AI Mentor ----------------------------------------------------------------
# true の間はAI Mentorはモック応答のみを返す（LLM APIを呼び出さない）。
# ローカル開発・Demo Modeでは既定でtrue。
AI_MENTOR_MOCK="true"
AI_MENTOR_PROVIDER="gemini" # gemini | mock
GEMINI_API_KEY=""
AI_MENTOR_DAILY_LIMIT="20" # 1ユーザー1日あたりのAI Mentor呼び出し上限

# --- Rate limiting (Upstash Redis, Full Modeのみ) -----------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Transactional email (Resend, Full Modeのみ) ------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@example.com"

# --- Error tracking (Sentry, 任意) --------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
